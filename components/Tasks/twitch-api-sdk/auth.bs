function validateOauthToken() as object
    activeUser = get_setting("active_user", "$default$")
    device_code = get_user_setting("device_code")
    token = get_user_setting("access_token")
    if activeUser = "$default$" or device_code = invalid or token = invalid or token = ""
        m.top.response = { "status": "anonymous", "tokenValid": true }
        m.top.control = TaskControl.STOP
        return invalid
    end if

    reqHeaders = {
        "Accept": "*/*",
        "Client-Id": "ue6666qo983tsx6so1t0vnawi233wa",
        "Device-ID": device_code,
        "Origin": "https://android.tv.twitch.tv",
        "Referer": "https://android.tv.twitch.tv/",
        "Accept-Language": getDeviceLocale(),
        "Authorization": "OAuth " + token
    }
    req = HttpRequest({
        url: "https://id.twitch.tv/oauth2/validate",
        headers: reqHeaders,
        method: "GET",
        timeout: 10000
    })
    sendResult = req.send()
    parsedRsp = invalid
    if sendResult <> invalid
        parsedRsp = ParseJSON(sendResult)
    end if
    m.top.response = classifyOauthValidation(activeUser, token, sendResult, parsedRsp)
    m.top.control = TaskControl.STOP
    return invalid
end function

sub getRendezvouzToken()
    req = HttpRequest({
        url: "https://id.twitch.tv/oauth2/device?scopes=channel_read%20chat%3Aread%20user_blocks_edit%20user_blocks_read%20user_follows_edit%20user_read&client_id=ue6666qo983tsx6so1t0vnawi233wa",
        headers: {
            "content-type": "application/x-www-form-urlencoded",
            "origin": "https://android.tv.twitch.tv",
            "referer": "https://android.tv.twitch.tv/"
        },
        method: "POST",
        timeout: 10000
    })
    rsp = ParseJSON(req.send() ?? "")
    if rsp = invalid or rsp?.device_code = invalid or rsp?.user_code = invalid
        m.top.response = invalid
        m.top.control = TaskControl.STOP
        return
    end if
    m.top.response = {
        device_code: rsp.device_code,
        user_code: rsp.user_code,
        interval: rsp?.interval ?? 5
    }
    m.top.control = TaskControl.STOP
end sub


function getOauthToken()
    if m.top.request.params.device_code = invalid
        m.top.response = invalid
        m.top.control = TaskControl.STOP
        return invalid
    end if
    pollIntervalSec = 5
    if m.top.request.params.interval <> invalid and m.top.request.params.interval > 1
        pollIntervalSec = m.top.request.params.interval
    end if
    maxAttempts = 360
    req = HttpRequest({
        url: "https://id.twitch.tv/oauth2/token" + "?client_id=ue6666qo983tsx6so1t0vnawi233wa&device_code=" + m.top.request.params.device_code + "&grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code",
        headers: {
            "content-type": "application/x-www-form-urlencoded",
            "origin": "https://android.tv.twitch.tv",
            "referer": "https://android.tv.twitch.tv/",
            "accept": "application/json"
        },
        method: "POST",
        timeout: 10000
    })
    rsp = invalid
    for attempt = 1 to maxAttempts
        raw = req.send()
        if raw <> invalid
            rsp = ParseJSON(raw)
            if rsp <> invalid
                if rsp.DoesExist("access_token")
                    exit for
                end if
                msg = ""
                if rsp.message <> invalid then msg = LCase(rsp.message.toStr())
                if msg = "slow_down"
                    pollIntervalSec = pollIntervalSec + 2
                else if rsp.status <> invalid and rsp.status >= 400 and msg <> "authorization_pending"
                    rsp = invalid
                    exit for
                end if
            end if
        end if
        sleep(pollIntervalSec * 1000)
    end for
    if rsp <> invalid and rsp?.access_token <> invalid
        m.top.response = {
            access_token: rsp.access_token
        }
    else
        m.top.response = invalid
    end if
    m.top.control = TaskControl.STOP
    return invalid
end function
