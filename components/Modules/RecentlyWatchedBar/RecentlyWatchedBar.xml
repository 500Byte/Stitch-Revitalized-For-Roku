<?xml version="1.0" encoding="utf-8"?>
<component name="RecentlyWatchedBar" extends="Group">
    <interface>
        <!-- Set true to give focus into the bar, false to release it back -->
        <field id="itemHasFocus" type="bool" value="false" onChange="onFocusToggle" alwaysNotify="true" />
        <!-- Emitted when user confirms a selection (OK key) -->
        <field id="contentSelected" type="node" alwaysNotify="true" />
        <!-- Emitted when the last channel was removed, so heroScene can take focus back -->
        <field id="becameEmpty" type="bool" alwaysNotify="true" />
        <function name="onDestroy" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/utils/recentlyWatched.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <script type="text/brightscript" uri="RecentlyWatchedBar.brs" />

    <children>
        <Rectangle
            id="backgroundBar"
            color="0x121215FF"
            width="78"
            height="1000"
            translation="[0, 0]"
        />
        <Rectangle
            id="rightBorder"
            color="0x26262CFF"
            width="1"
            height="1000"
            translation="[78, 0]"
        />
        <Poster
            id="icon"
            uri="pkg:/images/icons/recent.png"
            width="24"
            height="24"
            blendColor="0xADADB8FF"
            translation="[27, 18]"
        />
        <Group id="focusTooltip" visible="false" translation="[88, 58]">
            <Poster
                id="tooltipBg"
                uri="pkg:/images/capsule.9.png"
                width="220"
                height="44"
                blendColor="0x18181BF2"
            />
            <Label
                id="tooltipLabel"
                translation="[16, 10]"
                width="188"
                height="24"
                vertAlign="center"
                color="0xFFFFFFFF"
            >
                <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="18" />
            </Label>
        </Group>
    </children>
</component>
