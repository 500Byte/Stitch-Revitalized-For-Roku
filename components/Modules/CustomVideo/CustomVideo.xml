<?xml version="1.0" encoding="utf-8"?>

<component name="CustomVideo" extends="Video">

    <interface>
        <field id="thumbnailInfo" type="assocarray" />
        <field id="videoBookmarks" type="assocarray" />
        <field id="back" type="bool" value="false" />
        <field id="toggleChat" type="bool" value="false" />
        <field id="chatIsVisible" type="bool" />
        <field id="streamLayoutMode" type="Integer" value="-1" />
        <field id="busySpinner" type="bool" />
        <field id="channelAvatar" type="string" alias="avatar.uri" />
        <field id="channelUsername" type="string" alias="channelUsername.text" />
        <field id="videoTitle" type="string" alias="videoTitle.text" />
        <field id="QualityChangeRequestFlag" type="bool" value="false" />
        <field id="QualityChangeRequest" type="Integer" />
        <field id="streamDurationSeconds" type="Integer" value="0" />
        <field id="currentProgressBarState" type="Integer" value="1" />
        <field id="video_id" type="string" />
        <field id="video_type" type="string" />
        <field id="streamCreatedAt" type="string" />
        <field id="qualityOptions" type="array" />
        <field id="selectedQuality" type="string" />
        <field id="chatWidth" type="Integer" value="420" />
    </interface>
    <script type="text/brightscript" uri="CustomVideo.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <children>
        <!-- Modern Time Travel Dialog -->
        <Group id="timeTravelDialog" visible="false" translation="[660,360]">
            <Rectangle 
                color="0x1A1A1AE6" 
                width="600" 
                height="360" />
            <Rectangle 
                color="0x2D2D2DFF" 
                width="596" 
                height="356" 
                translation="[2,2]" />
            
            <!-- Header -->
            <SimpleLabel
                translation="[30,30]"
                text="Jump to Time"
                color="0xFFFFFFFF"
                fontSize="24"
                fontUri="pkg:/fonts/Archivo-Bold.otf" />
            <SimpleLabel
                translation="[30,65]"
                text="Enter the time you want to jump to"
                color="0xB3B3B3FF"
                fontSize="16"
                fontUri="pkg:/fonts/Archivo-Regular.otf" />
            
            <!-- Time Input Container -->
            <Group id="timeInputContainer" translation="[30,120]">
                <!-- Hours Section -->
                <Group id="hoursSection" translation="[0,0]">
                    <SimpleLabel
                        id="hoursLabel"
                        translation="[0,0]"
                        text="Hours"
                        color="0xB3B3B3FF"
                        fontSize="14"
                        fontUri="pkg:/fonts/Archivo-Regular.otf" />
                    
                    <!-- Hours Input Group -->
                    <Group id="hoursInputGroup" translation="[0,30]">
                        <Group id="hour0Group" translation="[0,0]">
                            <Rectangle id="hour0Bg" color="0x404040FF" width="50" height="60"  />
                            <Rectangle id="hour0" color="0x9146FFFF" width="50" height="60"  visible="false" />
                            <SimpleLabel id="hour0Text" translation="[20,18]" text="0" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                        </Group>
                        
                        <Group id="hour1Group" translation="[60,0]">
                            <Rectangle id="hour1Bg" color="0x404040FF" width="50" height="60"  />
                            <Rectangle id="hour1" color="0x9146FFFF" width="50" height="60"  visible="false" />
                            <SimpleLabel id="hour1Text" translation="[20,18]" text="0" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                        </Group>
                    </Group>
                </Group>
                
                <!-- Hours-Minutes Separator -->
                <SimpleLabel id="hourMinuteSeparator" translation="[125,48]" text=":" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                
                <!-- Minutes Section -->
                <Group id="minutesSection" translation="[150,0]">
                    <SimpleLabel
                        id="minutesLabel"
                        translation="[0,0]"
                        text="Minutes"
                        color="0xB3B3B3FF"
                        fontSize="14"
                        fontUri="pkg:/fonts/Archivo-Regular.otf" />
                    
                    <!-- Minutes Input Group -->
                    <Group id="minutesInputGroup" translation="[0,30]">
                        <Group id="minute0Group" translation="[0,0]">
                            <Rectangle id="minute0Bg" color="0x404040FF" width="50" height="60"  />
                            <Rectangle id="minute0" color="0x9146FFFF" width="50" height="60"  visible="false" />
                            <SimpleLabel id="minute0Text" translation="[20,18]" text="0" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                        </Group>
                        
                        <Group id="minute1Group" translation="[60,0]">
                            <Rectangle id="minute1Bg" color="0x404040FF" width="50" height="60"  />
                            <Rectangle id="minute1" color="0x9146FFFF" width="50" height="60"  visible="false" />
                            <SimpleLabel id="minute1Text" translation="[20,18]" text="0" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                        </Group>
                    </Group>
                </Group>
                
                <!-- Minutes-Seconds Separator -->
                <SimpleLabel id="minuteSecondSeparator" translation="[275,48]" text=":" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                
                <!-- Seconds Section -->
                <Group id="secondsSection" translation="[300,0]">
                    <SimpleLabel
                        id="secondsLabel"
                        translation="[0,0]"
                        text="Seconds"
                        color="0xB3B3B3FF"
                        fontSize="14"
                        fontUri="pkg:/fonts/Archivo-Regular.otf" />
                    
                    <!-- Seconds Input Group -->
                    <Group id="secondsInputGroup" translation="[0,30]">
                        <Group id="second0Group" translation="[0,0]">
                            <Rectangle id="second0Bg" color="0x404040FF" width="50" height="60"  />
                            <Rectangle id="second0" color="0x9146FFFF" width="50" height="60"  visible="false" />
                            <SimpleLabel id="second0Text" translation="[20,18]" text="0" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                        </Group>
                        
                        <Group id="second1Group" translation="[60,0]">
                            <Rectangle id="second1Bg" color="0x404040FF" width="50" height="60"  />
                            <Rectangle id="second1" color="0x9146FFFF" width="50" height="60"  visible="false" />
                            <SimpleLabel id="second1Text" translation="[20,18]" text="0" color="0xFFFFFFFF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                        </Group>
                    </Group>
                </Group>
            </Group>
            
            <!-- Instructions -->
            <SimpleLabel
                id="instructionsLabel"
                translation="[30,230]"
                text="Use ← → to navigate between fields, ↑ ↓ to change values"
                color="0x808080FF"
                fontSize="14"
                fontUri="pkg:/fonts/Archivo-Regular.otf" />
            
            <!-- Action Buttons Container -->
            <Group id="actionButtonsContainer" translation="[30,280]">
                <Group id="cancelButtonGroup" translation="[0,0]">
                    <Rectangle id="cancelButtonBg" color="0x404040FF" width="120" height="50"  />
                    <Rectangle id="cancelButton" color="0x404040FF" width="120" height="50"  />
                    <Rectangle id="cancelButtonFocus" color="0x9146FFFF" width="120" height="50"  visible="false" />
                    <SimpleLabel id="cancelButtonLabel" translation="[35,18]" text="Cancel" color="0xFFFFFFFF" fontSize="16" fontUri="pkg:/fonts/Archivo-Regular.otf" />
                </Group>
                
                <Group id="acceptButtonGroup" translation="[140,0]">
                    <Rectangle id="acceptButtonBg" color="0x404040FF" width="120" height="50"  />
                    <Rectangle id="acceptButton" color="0x404040FF" width="120" height="50"  />
                    <Rectangle id="acceptButtonFocus" color="0x9146FFFF" width="120" height="50"  visible="false" />
                    <SimpleLabel id="acceptButtonLabel" translation="[25,18]" text="Jump" color="0xFFFFFFFF" fontSize="16" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                </Group>
            </Group>
        </Group>

        <!-- Modern Floating HUD (Dual-Zone with Scrims - Punto Medio LG + Apple TV) -->
        <Group id="controlOverlay" visible="false">
            <!-- Top Scrim Gradient -->
            <Poster id="scrimTop" uri="pkg:/images/scrim_top.png" width="1920" height="180" loadDisplayMode="scaleToFit" translation="[0,0]" />

            <!-- Bottom Scrim Gradient (Cinema Contrast) -->
            <Poster id="scrimBottom" uri="pkg:/images/scrim_bottom.png" width="1920" height="340" loadDisplayMode="scaleToFit" translation="[0,740]" />

            <!-- Top Floating Header (Live Indicator & Status) -->
            <Group id="topOverlayGroup" translation="[0,48]">
                <!-- Live Indicator & Uptime Badge (Top Right) -->
                <Group id="liveIndicator" translation="[1630,0]" visible="false">
                    <Rectangle id="liveCapsuleBg" color="0x18181BE6" width="220" height="36" />
                    <Group id="liveBadgeGroup" translation="[4, 4]">
                        <Rectangle id="liveBadgeBg" color="0xEB0400FF" width="76" height="28" />
                        <SimpleLabel id="liveBadgeText" translation="[8, 4]" text="LIVE" color="0xFFFFFFFF" fontSize="16" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                    </Group>
                    <SimpleLabel id="uptimeLabel" translation="[88, 7]" text="" color="0xFFFFFFFF" fontSize="18" fontUri="pkg:/fonts/Archivo-Bold.otf" visible="false" />
                </Group>
            </Group>

            <!-- Bottom Floating HUD: Seekbar & Timestamps -->
            <Group id="bottomOverlayGroup" translation="[70,835]">
                <!-- Time Displays -->
                <SimpleLabel id="timeProgress" fontUri="pkg:/fonts/Archivo-Bold.otf" fontSize="18" color="0xFFFFFFFF" translation="[0,-2]" />
                <Label id="timeDuration" fontUri="pkg:/fonts/Archivo-Bold.otf" fontSize="18" color="0xADADB8FF" translation="[1680,-2]" width="100" horizAlign="right" />
                
                <!-- Progress Bar -->
                <Rectangle id="progressBarBase" color="0x3A3A3DFF" width="1780" height="8"  translation="[0,26]" />
                <Rectangle id="progressBarBuffer" color="0x53535FFF" width="0" height="8"  translation="[0,26]" />
                <Rectangle id="progressBarProgress" color="0x9146FFFF" width="0" height="8"  translation="[0,26]" />
                <Group id="mutedSegmentsGroup" translation="[0,26]" />
                
                <!-- Progress Dot -->
                <Group id="progressDot" translation="[0,19]">
                    <Rectangle color="0x9146FFFF" width="22" height="22" />
                    <Rectangle color="0xFFFFFFFF" width="10" height="10" translation="[6,6]" />
                </Group>
            </Group>

            <!-- Bottom Left: Channel & Stream Metadata (LG TV Anchor) -->
            <Group id="channelInfoGroup" translation="[70,892]">
                <CirclePoster id="avatar" width="60" height="60" translation="[0,0]" />
                <SimpleLabel id="channelUsername" translation="[76,4]" text="Channel Name" color="0xFFFFFFFF" fontSize="22" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                <EmojiLabel id="videoTitle" height="28" maxWidth="1150" horizAlign="left" color="0xADADB8FF" translation="[76,34]">
                    <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="16" />
                </EmojiLabel>
            </Group>

            <!-- Bottom Right: Action Capsules Row (Apple TV Pills) -->
            <Group id="actionControlsGroup" translation="[1336,890]">
                <!-- Hidden Back Button (node preserved for backwards compatibility) -->
                <Group id="backGroup" visible="false">
                    <Poster id="backBg" uri="pkg:/images/capsule.9.png" width="64" height="56" blendColor="0x26262CBB" />
                    <Poster id="backFocus" uri="pkg:/images/capsule.9.png" width="64" height="56" blendColor="0x9146FFFF" visible="false" />
                </Group>

                <!-- 0: Rewind Button (-10s) -->
                <Group id="rewindGroup" translation="[0,4]">
                    <Poster id="rewindBg" uri="pkg:/images/capsule.9.png" width="76" height="56" blendColor="0x26262CBB" />
                    <Poster id="rewindFocus" uri="pkg:/images/capsule.9.png" width="76" height="56" blendColor="0x9146FFFF" visible="false" />
                    <Poster uri="pkg:/images/icons/rotate-ccw-10.png" width="32" height="32" blendColor="0xFFFFFFFF" translation="[22,12]" />
                </Group>

                <!-- 1: Play/Pause Hero Button -->
                <Group id="playPauseGroup" translation="[88,0]">
                    <Poster id="playPauseBg" uri="pkg:/images/capsule.9.png" width="92" height="64" blendColor="0x3A3A3DEE" />
                    <Poster id="playPauseFocus" uri="pkg:/images/capsule.9.png" width="92" height="64" blendColor="0x9146FFFF" visible="false" />
                    <Poster id="controlButton" uri="pkg:/images/icons/pause-hero.png" width="36" height="36" blendColor="0xFFFFFFFF" translation="[28,14]" />
                </Group>

                <!-- 2: Fast Forward Button (+10s) -->
                <Group id="fastForwardGroup" translation="[192,4]">
                    <Poster id="fastForwardBg" uri="pkg:/images/capsule.9.png" width="76" height="56" blendColor="0x26262CBB" />
                    <Poster id="fastForwardFocus" uri="pkg:/images/capsule.9.png" width="76" height="56" blendColor="0x9146FFFF" visible="false" />
                    <Poster uri="pkg:/images/icons/rotate-cw-10.png" width="32" height="32" blendColor="0xFFFFFFFF" translation="[22,12]" />
                </Group>

                <!-- 3: Time Travel Button -->
                <Group id="timeTravelGroup" translation="[290,4]">
                    <Poster id="timeTravelBg" uri="pkg:/images/capsule.9.png" width="64" height="56" blendColor="0x26262CBB" />
                    <Poster id="timeTravelFocus" uri="pkg:/images/capsule.9.png" width="64" height="56" blendColor="0x9146FFFF" visible="false" />
                    <Poster uri="pkg:/images/icons/time-travel.png" width="30" height="30" blendColor="0xFFFFFFFF" translation="[17,13]" />
                </Group>

                <!-- 4: Chat Toggle Button -->
                <Group id="chatGroup" translation="[366,4]">
                    <Poster id="chatBg" uri="pkg:/images/capsule.9.png" width="72" height="56" blendColor="0x26262CBB" />
                    <Poster id="chatFocus" uri="pkg:/images/capsule.9.png" width="72" height="56" blendColor="0x9146FFFF" visible="false" />
                    <Poster uri="pkg:/images/icons/chat-bubble.png" width="30" height="30" blendColor="0xFFFFFFFF" translation="[21,13]" />
                </Group>

                <!-- 5: Settings Gear Button -->
                <Group id="settingsGroup" translation="[450,4]">
                    <Poster id="settingsBg" uri="pkg:/images/capsule.9.png" width="64" height="56" blendColor="0x26262CBB" />
                    <Poster id="settingsFocus" uri="pkg:/images/capsule.9.png" width="64" height="56" blendColor="0x9146FFFF" visible="false" />
                    <Poster uri="pkg:/images/icons/settings-gear.png" width="30" height="30" blendColor="0xFFFFFFFF" translation="[17,13]" />
                </Group>
            </Group>
            
        </Group>

        <!-- Thumbnail Preview -->
        <Group id="thumbnailPreview" translation="[0,760]" visible="false">
            <Rectangle color="0x000000E6" width="200" height="130"  />
            <Group id="thumbnails" clippingRect="[4,4,192,112]" translation="[4,4]">
                <Poster id="thumbnailImage" />
            </Group>
            <SimpleLabel id="thumbnailTime" translation="[10,115]" text="00:00" color="0xFFFFFFFF" fontSize="12" fontUri="pkg:/fonts/Archivo-Bold.otf" />
        </Group>
        
        <!-- Loading Overlay -->
        <Group id="loadingOverlay" translation="[960,540]" visible="true">
            <!-- Vertical layout container -->
            <LayoutGroup 
                layoutDirection="vert"
                horizAlignment="center"
                vertAlignment="center"
                itemSpacings="[15]">
                
                <!-- Spinner -->
                <BusySpinner 
                    id="loadingSpinner"
                    uri="pkg:/images/spinner.png"
                    spinInterval="1" />
                
                <!-- Text -->
                <SimpleLabel 
                    id="loadingText"
                    text="Loading video..."
                    color="0xFFFFFFFF"
                    fontSize="18"
                    fontUri="pkg:/fonts/Archivo-Regular.otf" />
            </LayoutGroup>
        </Group>

        <!-- Toast notifications (outside controlOverlay so they display even when controls are hidden) -->
        <Group id="chatModeToastGroup" translation="[820, 60]" visible="false">
            <Rectangle id="chatModeToastBg" color="0x000000D0" width="280" height="42" />
            <Label id="chatModeToast" translation="[0, 8]" width="280" horizAlign="center" text="" color="0xFFFFFFFF" fontSize="20" fontUri="pkg:/fonts/Archivo-Bold.otf" />
        </Group>

        <Group id="muteSkipToastGroup" translation="[760, 60]" visible="false">
            <Rectangle id="muteSkipToastBg" color="0xE91E63E6" width="400" height="42" />
            <Label id="muteSkipToast" translation="[0, 8]" width="400" horizAlign="center" text="" color="0xFFFFFFFF" fontSize="18" fontUri="pkg:/fonts/Archivo-Bold.otf" />
        </Group>

        <!-- Netflix-style Skip Muted Audio Button -->
        <Group id="skipMuteButton" translation="[1480, 840]" visible="false">
            <Rectangle id="skipMuteBg" color="0x18181BF0" width="360" height="52" />
            <Rectangle id="skipMuteAccent" color="0xE91E63FF" width="6" height="52" />
            <!-- [OK] badge -->
            <Rectangle color="0xE91E63FF" width="48" height="30" translation="[18, 11]" />
            <Label translation="[18, 16]" width="48" horizAlign="center" text="OK" color="0xFFFFFFFF" fontSize="15" fontUri="pkg:/fonts/Archivo-Bold.otf" />
            <!-- Label -->
            <SimpleLabel translation="[78, 13]" text="Saltar silencio" color="0xFFFFFFFF" fontSize="20" fontUri="pkg:/fonts/Archivo-Bold.otf" />
        </Group>

        <!-- Modern Quality Selection Modal (Twitch TV style) -->
        <QualityDialog id="qualityDialogModal" visible="false" />
    </children>
</component>