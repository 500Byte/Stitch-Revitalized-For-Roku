<?xml version="1.0" encoding="utf-8"?>

<component name="VideoItem" extends="Group">

    <interface>
        <field id="itemContent" type="node" onChange="showcontent" />
        <field id="rowFocusPercent" type="float" onChange="showrowfocus" />
        <field id="itemHasFocus" type="boolean" onChange="onGetfocus" />
    </interface>

    <script type="text/brightscript" uri="VideoItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/contentBuilder.brs" />
    <children>
        <Poster
            id="itemPoster"
            height="225"
            width="400"
            loadWidth="400"
            loadHeight="225"
            loadDisplayMode="scaleToFit">
            <Group id="liveIcon" translation="[10,10]">
                <Poster id="liveBg" uri="pkg:/images/capsule.9.png" width="88" height="28" blendColor="0xEB0400FF" />
                <Label
                    id="liveBadgeText"
                    width="88"
                    height="28"
                    horizAlign="center"
                    vertAlign="center"
                    color="0xFFFFFFFF"
                    text="LIVE">
                    <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
                </Label>
            </Group>

        </Poster>
        <CirclePoster id="circlePoster" height="150" width="150" visible="false" />
        <CirclePoster id="streamAvatar" height="48" width="48" translation="[0,238]" outlineColor="0x00000000" backgroundVisible="false" visible="false" />
        <Rectangle
            id="itemMask"
            color="0x0e0e10ff"
            visible="false"
            opacity="0.75"
            width="512"
            height="288"
            scaleRotateCenter="[ 256.0, 144.0 ]" />
        <EmojiLabel
            id="itemLabel"
            height="26"
            emojiSize="20"
            vertAlign="top"
            horizAlign="left"
            maxWidth="340"
            color="0xFFFFFFFF"
            translation="[60, 236]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="20" />
        </EmojiLabel>
        <Label
            id="plainTitle"
            height="26"
            width="188"
            horizAlign="left"
            color="0xFFFFFFFF"
            visible="false">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="20" />
        </Label>
        <Label
            id="itemStreamer"
            height="24"
            width="340"
            horizAlign="left"
            color="0xDEDEE3FF"
            visible="false"
            translation="[60, 264]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
        </Label>
        <Label
            id="itemSubtitle"
            height="22"
            width="340"
            horizAlign="left"
            color="0xADADB8FF"
            translation="[60, 288]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="17" />
        </Label>
        <Poster
            id="viewsRect"
            uri="pkg:/images/capsule.9.png"
            blendColor="0x0E0E10CC"
            height="28"
            translation="[10,187]">
        </Poster>
        <Label
            id="itemViewers"
            height="28"
            vertAlign="center"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[20,187]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>
        <Poster
            id="runtimeRect"
            uri="pkg:/images/live_rectangle.9.png"
            visible="false"
            translation="[5,23]">
        </Poster>
        <Label
            id="runtimeLabel"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[7,23]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="16" />
        </Label>
        <Poster
            id="timestampRect"
            uri="pkg:/images/capsule.9.png"
            blendColor="0x0E0E10CC"
            height="28"
            translation="[10,10]">
        </Poster>
        <Label
            id="timestampLabel"
            height="28"
            vertAlign="center"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[20,10]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>

    </children>

</component>