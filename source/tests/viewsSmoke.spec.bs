namespace tests

    @suite("ViewsSmoke")
    class ViewsSmokeTests extends rooibos.BaseTestSuite

        @describe("SceneGraph UI component instantiation")

        @it("instantiates UI panels and views without warnings or errors")
        sub instantiatesUiViews()
            names = [
                "MenuBar",
                "VideoItem",
                "ChannelPage",
                "GamePage",
                "Settings",
                "Search",
                "LoginPage"
            ]
            for each name in names
                node = CreateObject("roSGNode", name)
                m.assertNotInvalid(node, name + " should instantiate cleanly")
                if name <> "VideoItem"
                    node.callFunc("onDestroy")
                end if
            end for
        end sub

    end class

end namespace
